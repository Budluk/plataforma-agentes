# CentralIA / plataforma-agentes: modelo de configuração.
# Copie este arquivo para ".env" e preencha. NUNCA coloque valores reais aqui (este arquivo vai para o Git).
# O ".env" real é ignorado pelo Git. Se faltar GROQ_API_KEY, o cliente de LLM informa o nome da variável.

# --- OBRIGATÓRIO para usar o LLM (provedor padrão: Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- OPCIONAL: contato enviado como User-Agent aos sites consultados pela pesquisa ---
RESEARCH_USER_AGENT=plataforma-agentes/0.1 (contato: SEU-EMAIL-OU-URL)

# --- OPCIONAL: CloneStudio (área studio) ---
# Serviço Node local vendorizado em clonestudio/. Só hosts de config/studio_hosts.txt.
STUDIO_BASE_URL=http://127.0.0.1:8787
STUDIO_TIMEOUT_MS=30000

# --- OPCIONAL: outros provedores previstos no cliente (os scripts atuais usam só a Groq) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
