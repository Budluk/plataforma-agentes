# Backend
HOST=127.0.0.1
PORT=8787
NODE_ENV=development

# Servidor separado que entrega o build de cada app gerado (iframe isolado).
PREVIEW_PORT=8788
# Opcional: URL pública do preview (ex.: https://preview.seudominio.com)
PREVIEW_PUBLIC_URL=

# Validação automática do preview em navegador headless (playwright-core).
PREVIEW_VALIDATION=on
PREVIEW_VALIDATION_TIMEOUT_MS=35000
# Host usado pelo navegador headless para alcançar o servidor de preview.
PREVIEW_VALIDATION_HOST=127.0.0.1
# Opcional: canal (msedge, chrome) ou caminho do executável. Vazio = detecta Edge/Chrome.
PREVIEW_BROWSER_CHANNEL=
# Escape hatch: 1 volta a permitir 'unsafe-eval' na CSP do preview (apps antigos).
PREVIEW_ALLOW_UNSAFE_EVAL=0

# Ordem de fallback. Somente provedores com URL configurada serão tentados.
AI_PROVIDER_ORDER=freellmapi,ollama,localllm,llamacpp
AI_DEFAULT_MODEL=gpt-oss-120b
AI_REQUEST_TIMEOUT_MS=360000
AI_GENERATION_TIMEOUT_MS=480000
AI_CODEGEN_MAX_TOKENS=12000
AI_MAX_TOKENS=12000
BUILD_TIMEOUT_MS=240000
# Memoria maxima do Node no child que compila o app (sanitiza chaves do ambiente).
CLONESTUDIO_BUILD_HEAP_MB=512

# Desempenho do painel
# Janela em que a varredura de src/ é reaproveitada antes de checar mudanças (ms).
SOURCE_SCAN_TTL_MS=5000
# Agrupa gravações de data/projects.json neste intervalo (ms). 0 grava na hora.
PERSIST_DELAY_MS=150

# Auditoria estruturada (JSONL). Vazio = DATA_DIR/audit.jsonl.
# Nunca registra corpo de requisição, prompt nem resposta bruta do modelo.
CLONESTUDIO_AUDIT_PATH=
CLONESTUDIO_AUDIT_MAX_BYTES=5000000
CLONESTUDIO_AUDIT_BACKUPS=3

# Fila duravel de jobs (DATA_DIR/jobs.json). Sem Redis: worker no proprio processo.
CLONESTUDIO_JOB_CONCURRENCY=2
# Quantidade maxima de registros terminados mantidos no historico.
CLONESTUDIO_JOB_HISTORY=100

# FreeLLMAPI (padrão) — endpoint OpenAI-compatible do gateway local.
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_API_KEY=
# Modelos rápidos e gratuitos via OVH keyless (2 req/min por modelo no OVH).
FREELLMAPI_MODEL=gpt-oss-120b
FREELLMAPI_FALLBACK_MODELS=qwen3.8-27b,qwen3.5-397b,nemotron-3-ultra-550b

# Ollama (opcional)
OLLAMA_BASE_URL=
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.2

# LocalAI (opcional)
LOCALAI_BASE_URL=
LOCALAI_API_KEY=
LOCALAI_MODEL=gpt-4

# llama.cpp server (opcional)
LLAMACPP_BASE_URL=
LLAMACPP_API_KEY=llama
LLAMACPP_MODEL=local-model

# Context7 (documentação atualizada via MCP; funciona sem chave)
CONTEXT7_ENABLED=on
CONTEXT7_BASE_URL=https://mcp.context7.com/mcp
CONTEXT7_API_KEY=
CONTEXT7_TIMEOUT_MS=12000
CONTEXT7_MAX_LIBRARIES=2
CONTEXT7_MAX_CHARS=6000
CONTEXT7_CACHE_TTL_MS=1800000

# Importação por arrasto (link, GitHub, .zip ou cópia de app)
# Limite do download (site, .zip e repositório) em bytes.
IMPORT_MAX_BYTES=20000000
# Limite do código importado gravado em src/.
IMPORT_MAX_SOURCE_BYTES=1500000
# Limite de imagens/fontes/áudio/vídeo copiados do app importado.
IMPORT_MAX_ASSET_BYTES=8000000
# Tempo máximo para baixar a página de referência.
IMPORT_SITE_TIMEOUT_MS=25000
# Cache da análise antes de criar (GitHub/.zip).
IMPORT_INSPECTION_TTL_MS=900000
IMPORT_INSPECTION_CACHE=8
IMPORT_INSPECTION_MAX_ENTRIES=6000
# Token opcional para elevar o limite da API pública do GitHub.
GITHUB_TOKEN=

# Integrações opcionais (não são necessárias para o núcleo)
COMPOSIO_API_KEY=
FIRECRAWL_API_KEY=
APIFY_API_TOKEN=
GOOGLE_WORKSPACE_CLI_ENABLED=false

# Armazenamento local (padrão: ./data)
# DATA_DIR=
